# ------------------------------------------------------------------
# SAVI — variables d'environnement
# Copier ce fichier en .env.local pour le développement. Ne JAMAIS versionner .env* (déjà ignoré par Git).
# Aucune variable n'est obligatoire en développement : sans DATABASE_URL, une base PostgreSQL embarquée
# (PGlite) est créée automatiquement dans ./.data/pglite.
# ------------------------------------------------------------------

# URL publique de l'application (liens absolus, cookies, webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autoriser l'affichage dans un cadre (iframe) — UNIQUEMENT pour la prévisualisation sandbox. Laisser vide en production.
# (pris en compte au moment du `next build`)
SAVI_ALLOW_EMBED=

# --- Base de données (PostgreSQL) --------------------------------------------
# Vide = PGlite local (développement, tests). En préproduction/production : URL PostgreSQL (Neon, Supabase, VPS…).
# DATABASE_URL=postgresql://user:password@host:5432/savi?sslmode=require
# Sur Netlify, NETLIFY_DATABASE_URL (Netlify DB / Neon) est injectée automatiquement et utilisée si DATABASE_URL est absente.
# DB_AUTO_MIGRATE=0                  # désactive l'exécution automatique des migrations au démarrage (PostgreSQL)
# DATABASE_POOL_MAX=5
# Dossier des données PGlite (développement uniquement)
# PGLITE_DATA_DIR=./.data/pglite

# --- Essai gratuit et tarifs (calculés côté serveur) -------------------------
TRIAL_DAYS=4
PRICING_MONTHLY_XOF=1000
PRICING_YEARLY_XOF=10000
# Mettre 1 quand les tarifs sont définitivement validés (retire la mention « à confirmer »)
PRICING_CONFIRMED=0

# --- Stockage des documents importés -----------------------------------------
STORAGE_PROVIDER=local              # local (disque du serveur : développement, VPS) | s3 (Vercel ou tout hébergeur sans disque persistant) | netlify-blobs (Netlify)
# UPLOADS_DIR=./.data/uploads
MAX_UPLOAD_MB=10
# Stockage objet compatible S3 — bucket PRIVÉ (Cloudflare R2 recommandé : 10 Go gratuits, pas de frais de sortie)
# S3_ENDPOINT=                      # ex. https://<id-compte>.r2.cloudflarestorage.com ou https://s3.eu-west-3.amazonaws.com
# S3_BUCKET=savi-documents
# S3_REGION=auto                    # "auto" pour R2, sinon la région AWS/B2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1             # 1 (R2, MinIO, B2) | 0 (AWS S3 avec sous-domaine du bucket)

# --- IA (clés côté serveur uniquement, jamais NEXT_PUBLIC_) -----------------
# Sans clé : AI_PROVIDER=mock => « mode démonstration » (IA simulée, clairement signalée à l'écran).
AI_PROVIDER=mock                    # anthropic (recommandé) | openai | mock
# AI_MODEL_FAST=claude-haiku-4-5    # réponses courantes (tuteur, fiches, quiz)
# AI_MODEL_STRONG=claude-sonnet-4-5 # mode strict, corrections de devoirs, lecture d'images
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                  # fournisseur compatible OpenAI (ex. Mistral, Groq) si AI_PROVIDER=openai

# Plafonds journaliers par utilisateur (anti-abus et maîtrise des coûts)
DAILY_LIMIT_TUTOR_MESSAGES=150
DAILY_LIMIT_GRADINGS=20
DAILY_LIMIT_GENERATIONS=30
DAILY_LIMIT_UPLOADS=40

# --- Lecture des documents (OCR) ---------------------------------------------
# Les PDF texte sont lus directement. Les photos sont lues par le modèle d'IA (vision) quand une clé est
# configurée, sinon par Tesseract.js en local : lancer `npm run ocr:setup` pour télécharger les données fra+eng.
# TESSDATA_DIR=./.data/tessdata
# Délai maximal de lecture OCR locale en millisecondes (défaut 60000)
# OCR_TIMEOUT_MS=60000

# --- Progression -------------------------------------------------------------
WEEKLY_GOAL_SESSIONS=4

# --- Environnement applicatif --------------------------------------------------
# development | test | preview | production. Déduit de NODE_ENV si absent. En `production`, le prestataire de
# paiement « sandbox » est refusé (aucun paiement simulé en production) et le bandeau de test n'apparaît pas.
# APP_ENV=production

# --- Abonnement et paiement ------------------------------------------------------
# Prestataire de paiement :
#   disabled → boutons de paiement inactifs (état par défaut tant que rien n'est confirmé)
#   link     → lien de paiement fourni par l'équipe SAVI (PAYMENT_LINK_URL, https obligatoire) ; l'élève reçoit une
#              référence SAVI-XXXXXXXX à indiquer, déclare « j'ai payé », puis un administrateur confirme dans
#              /admin/paiements après vérification de la transaction. Aucune activation automatique.
#   webhook  → prestataire ou relais qui redirige vers PAYMENT_CHECKOUT_URL et notifie SAVI par un webhook signé
#              (en-tête X-Savi-Signature, HMAC-SHA256 avec PAYMENT_WEBHOOK_SECRET). Activation automatique.
#   sandbox  → simulation locale pour les tests et la prévisualisation UNIQUEMENT (refusé si APP_ENV=production).
# PAYMENT_PROVIDER=disabled
# PAYMENT_LINK_URL=https://…
# PAYMENT_CHECKOUT_URL=https://…/payer?ref={reference}&montant={amount}&devise={currency}&retour={return_url}
# PAYMENT_WEBHOOK_SECRET=            # ≥ 16 caractères aléatoires, partagé uniquement avec le prestataire/relais
# Administrateurs des paiements (e-mails ou numéros séparés par des virgules). Accès limité à /admin/paiements.
# ADMIN_IDENTIFIERS=

# --- Envoi d'e-mails / SMS (réinitialisation de mot de passe, à activer plus tard) ---
# EMAIL_PROVIDER=disabled
# SMS_PROVIDER=disabled
